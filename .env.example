# PostgreSQL
POSTGRES_PASSWORD=<your-secure-password-here>

# Backend
DATABASE_URL=postgresql+asyncpg://soas:<your-secure-password-here>@localhost:5432/soas
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SOC on a Stick
WEBAUTHN_ORIGIN=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USER_SECRET_ENCRYPTION_KEY=<generate-a-fernet-key>

# Inter-service API token
SOAS_API_TOKEN=<generate-a-secure-token>

# Frontend
VITE_API_URL=http://localhost:8000

# MCP server bearer (required) — every request to /mcp/* must present this.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SERVER_TOKEN=<generate-a-random-string>

# Proxy ports (optional — defaults shown). The proxy is the only host-published service.
SOAS_HTTPS_PORT=443
SOAS_HTTP_PORT=80

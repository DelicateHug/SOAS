{
  "name": "soas",
  "displayName": "SOC on a Stick",
  "description": "Full-featured SOC platform extension — incidents, cases, automations, wiki, and AI-assisted workflows",
  "version": "0.1.0",
  "publisher": "soas",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.mjs",
    "build:webview": "cd webview-ui && npm run build",
    "watch": "concurrently \"node esbuild.mjs --watch\" \"cd webview-ui && npm run dev\"",
    "copy-types": "node -e \"require('fs').copyFileSync('../frontend/src/types/api.ts','src/api/types.ts')\"",
    "prebuild": "npm run copy-types",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "contributes": {
    "configuration": {
      "title": "SOC on a Stick",
      "properties": {
        "soas.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "SOAS backend server URL"
        },
        "soas.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Seconds between auto-refresh of tree views"
        },
        "soas.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable development mode (allows editing in dev tier)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "soas-explorer",
          "title": "SOAS",
          "icon": "resources/soas-icon.svg"
        }
      ]
    },
    "views": {
      "soas-explorer": [
        {
          "id": "soas-welcome",
          "name": "SOAS",
          "when": "!soas.isAuthenticated",
          "type": "webview"
        },
        {
          "id": "soas-incidents",
          "name": "Incidents",
          "when": "soas.isAuthenticated"
        },
        {
          "id": "soas-cases",
          "name": "Cases",
          "when": "soas.isAuthenticated"
        },
        {
          "id": "soas-automations",
          "name": "Automations",
          "when": "soas.isAuthenticated"
        },
        {
          "id": "soas-wiki",
          "name": "Wiki",
          "when": "soas.isAuthenticated"
        },
        {
          "id": "soas-executions",
          "name": "Executions",
          "when": "soas.isAuthenticated"
        },
        {
          "id": "soas-issues",
          "name": "Issues",
          "when": "soas.isAuthenticated"
        },
        {
          "id": "soas-teams",
          "name": "Teams",
          "when": "soas.isAuthenticated"
        },
        {
          "id": "soas-admin",
          "name": "Administration",
          "when": "soas.isAuthenticated && soas.isAdmin",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "soas.login",
        "title": "SOAS: Login",
        "icon": "$(sign-in)"
      },
      {
        "command": "soas.logout",
        "title": "SOAS: Logout",
        "icon": "$(sign-out)"
      },
      {
        "command": "soas.openDashboard",
        "title": "SOAS: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "soas.openMonitoring",
        "title": "SOAS: Open Monitoring",
        "icon": "$(pulse)"
      },
      {
        "command": "soas.switchTeam",
        "title": "SOAS: Switch Team",
        "icon": "$(organization)"
      },
      {
        "command": "soas.incidents.create",
        "title": "SOAS: Create Incident",
        "icon": "$(add)"
      },
      {
        "command": "soas.incidents.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "soas.incidents.open",
        "title": "Open Incident",
        "icon": "$(eye)"
      },
      {
        "command": "soas.incidents.changeStatus",
        "title": "Change Status",
        "icon": "$(pencil)"
      },
      {
        "command": "soas.incidents.filter",
        "title": "Filter Incidents",
        "icon": "$(filter)"
      },
      {
        "command": "soas.cases.create",
        "title": "SOAS: Create Case",
        "icon": "$(add)"
      },
      {
        "command": "soas.cases.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "soas.cases.open",
        "title": "Open Case",
        "icon": "$(eye)"
      },
      {
        "command": "soas.automations.create",
        "title": "SOAS: Create Automation",
        "icon": "$(add)"
      },
      {
        "command": "soas.automations.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "soas.automations.openEditor",
        "title": "Open in Graph Editor",
        "icon": "$(circuit-board)"
      },
      {
        "command": "soas.automations.compile",
        "title": "Compile Automation",
        "icon": "$(gear)"
      },
      {
        "command": "soas.automations.run",
        "title": "Run Automation",
        "icon": "$(play)"
      },
      {
        "command": "soas.automations.testRun",
        "title": "Test Run Automation",
        "icon": "$(debug-start)"
      },
      {
        "command": "soas.wiki.create",
        "title": "SOAS: Create Wiki Page",
        "icon": "$(add)"
      },
      {
        "command": "soas.wiki.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "soas.wiki.openEditor",
        "title": "Edit Wiki Page",
        "icon": "$(edit)"
      },
      {
        "command": "soas.wiki.search",
        "title": "SOAS: Search Wiki",
        "icon": "$(search)"
      },
      {
        "command": "soas.executions.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "soas.executions.view",
        "title": "View Execution Output",
        "icon": "$(terminal)"
      },
      {
        "command": "soas.executions.cancel",
        "title": "Cancel Execution",
        "icon": "$(debug-stop)"
      },
      {
        "command": "soas.issues.create",
        "title": "SOAS: Create Issue",
        "icon": "$(add)"
      },
      {
        "command": "soas.issues.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "soas.issues.open",
        "title": "Open Issue",
        "icon": "$(eye)"
      },
      {
        "command": "soas.ai.explainAutomation",
        "title": "SOAS: AI Explain Automation"
      },
      {
        "command": "soas.ai.generateAutomation",
        "title": "SOAS: AI Generate Automation"
      },
      {
        "command": "soas.ai.generateWikiPage",
        "title": "SOAS: AI Generate Wiki Page"
      },
      {
        "command": "soas.ai.improveWikiPage",
        "title": "SOAS: AI Improve Wiki Page"
      },
      {
        "command": "soas.admin.users",
        "title": "SOAS: Manage Users",
        "icon": "$(people)"
      },
      {
        "command": "soas.admin.roles",
        "title": "SOAS: Manage Roles",
        "icon": "$(shield)"
      },
      {
        "command": "soas.admin.soasVariables",
        "title": "SOAS: SOAS Variables",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "soas.admin.incidentVariables",
        "title": "SOAS: Incident Variables",
        "icon": "$(file-text)"
      },
      {
        "command": "soas.admin.formDefinitions",
        "title": "SOAS: Form Definitions",
        "icon": "$(clippy)"
      },
      {
        "command": "soas.admin.webhooks",
        "title": "SOAS: Webhooks",
        "icon": "$(radio-tower)"
      },
      {
        "command": "soas.admin.webhookSources",
        "title": "SOAS: Webhook Sources",
        "icon": "$(plug)"
      },
      {
        "command": "soas.admin.normalization",
        "title": "SOAS: Normalization Rules",
        "icon": "$(settings)"
      },
      {
        "command": "soas.admin.userSecrets",
        "title": "SOAS: User Secrets (Admin)",
        "icon": "$(key)"
      },
      {
        "command": "soas.admin.reviewChanges",
        "title": "SOAS: Review Changes",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "soas.admin.settings",
        "title": "SOAS: System Settings",
        "icon": "$(gear)"
      },
      {
        "command": "soas.admin.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "soas.teams.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "soas.teams.setActive",
        "title": "Set as Active Team",
        "icon": "$(check)"
      },
      {
        "command": "soas.teams.create",
        "title": "SOAS: Create Team",
        "icon": "$(add)"
      },
      {
        "command": "soas.teams.edit",
        "title": "Edit Team",
        "icon": "$(edit)"
      },
      {
        "command": "soas.teams.delete",
        "title": "Delete Team",
        "icon": "$(trash)"
      },
      {
        "command": "soas.teams.addMember",
        "title": "Add Member",
        "icon": "$(person-add)"
      },
      {
        "command": "soas.teams.removeMember",
        "title": "Remove Member",
        "icon": "$(remove)"
      },
      {
        "command": "soas.teams.editMember",
        "title": "Edit Member Roles",
        "icon": "$(edit)"
      },
      {
        "command": "soas.teams.createVariable",
        "title": "Add Variable",
        "icon": "$(add)"
      },
      {
        "command": "soas.teams.editVariable",
        "title": "Edit Variable",
        "icon": "$(edit)"
      },
      {
        "command": "soas.teams.deleteVariable",
        "title": "Delete Variable",
        "icon": "$(trash)"
      },
      {
        "command": "soas.teams.manageVariablePermissions",
        "title": "Manage Permissions",
        "icon": "$(shield)"
      },
      {
        "command": "soas.showOutput",
        "title": "SOAS: Show Output Channel"
      },
      {
        "command": "soas.toggleDevMode",
        "title": "SOAS: Toggle Dev Mode / Production Mode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "soas.incidents.create",
          "when": "view == soas-incidents",
          "group": "navigation@1"
        },
        {
          "command": "soas.incidents.filter",
          "when": "view == soas-incidents",
          "group": "navigation@2"
        },
        {
          "command": "soas.incidents.refresh",
          "when": "view == soas-incidents",
          "group": "navigation@3"
        },
        {
          "command": "soas.cases.create",
          "when": "view == soas-cases",
          "group": "navigation@1"
        },
        {
          "command": "soas.cases.refresh",
          "when": "view == soas-cases",
          "group": "navigation@2"
        },
        {
          "command": "soas.automations.create",
          "when": "view == soas-automations",
          "group": "navigation@1"
        },
        {
          "command": "soas.automations.refresh",
          "when": "view == soas-automations",
          "group": "navigation@2"
        },
        {
          "command": "soas.wiki.create",
          "when": "view == soas-wiki",
          "group": "navigation@1"
        },
        {
          "command": "soas.wiki.search",
          "when": "view == soas-wiki",
          "group": "navigation@2"
        },
        {
          "command": "soas.wiki.refresh",
          "when": "view == soas-wiki",
          "group": "navigation@3"
        },
        {
          "command": "soas.executions.refresh",
          "when": "view == soas-executions",
          "group": "navigation@1"
        },
        {
          "command": "soas.issues.create",
          "when": "view == soas-issues",
          "group": "navigation@1"
        },
        {
          "command": "soas.issues.refresh",
          "when": "view == soas-issues",
          "group": "navigation@2"
        },
        {
          "command": "soas.teams.create",
          "when": "view == soas-teams",
          "group": "navigation@1"
        },
        {
          "command": "soas.teams.refresh",
          "when": "view == soas-teams",
          "group": "navigation@2"
        },
        {
          "command": "soas.admin.refresh",
          "when": "view == soas-admin",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "soas.teams.setActive",
          "when": "view == soas-teams && viewItem =~ /^team(?!-member|.*variable)/",
          "group": "inline@1"
        },
        {
          "command": "soas.teams.edit",
          "when": "view == soas-teams && viewItem =~ /^team(?!-member|.*variable)/",
          "group": "1_team@1"
        },
        {
          "command": "soas.teams.addMember",
          "when": "view == soas-teams && viewItem =~ /^team(?!-member|.*variable)|^member-header/",
          "group": "1_team@2"
        },
        {
          "command": "soas.teams.delete",
          "when": "view == soas-teams && viewItem =~ /^team(?!-default)(?!-member|.*variable)/",
          "group": "2_danger@1"
        },
        {
          "command": "soas.teams.editMember",
          "when": "view == soas-teams && viewItem == team-member",
          "group": "inline@1"
        },
        {
          "command": "soas.teams.removeMember",
          "when": "view == soas-teams && viewItem == team-member",
          "group": "1_member@1"
        },
        {
          "command": "soas.teams.createVariable",
          "when": "view == soas-teams && viewItem == variable-header",
          "group": "inline@1"
        },
        {
          "command": "soas.teams.editVariable",
          "when": "view == soas-teams && viewItem == team-variable",
          "group": "inline@1"
        },
        {
          "command": "soas.teams.manageVariablePermissions",
          "when": "view == soas-teams && viewItem == team-variable",
          "group": "1_variable@1"
        },
        {
          "command": "soas.teams.deleteVariable",
          "when": "view == soas-teams && viewItem == team-variable",
          "group": "2_danger@1"
        },
        {
          "command": "soas.incidents.open",
          "when": "view == soas-incidents && viewItem =~ /^incident/",
          "group": "inline@1"
        },
        {
          "command": "soas.incidents.changeStatus",
          "when": "view == soas-incidents && viewItem =~ /^incident/",
          "group": "1_actions@1"
        },
        {
          "command": "soas.automations.openEditor",
          "when": "view == soas-automations && viewItem =~ /^automation/",
          "group": "inline@1"
        },
        {
          "command": "soas.automations.run",
          "when": "view == soas-automations && viewItem =~ /^automation/",
          "group": "inline@2"
        },
        {
          "command": "soas.automations.compile",
          "when": "view == soas-automations && viewItem =~ /^automation/",
          "group": "1_actions@1"
        },
        {
          "command": "soas.automations.testRun",
          "when": "view == soas-automations && viewItem =~ /^automation/",
          "group": "1_actions@2"
        },
        {
          "command": "soas.wiki.openEditor",
          "when": "view == soas-wiki && viewItem =~ /^wiki-page/",
          "group": "inline@1"
        },
        {
          "command": "soas.executions.view",
          "when": "view == soas-executions && viewItem =~ /^execution/",
          "group": "inline@1"
        },
        {
          "command": "soas.executions.cancel",
          "when": "view == soas-executions && viewItem =~ /^execution-(pending|running)/",
          "group": "1_actions@1"
        },
        {
          "command": "soas.cases.open",
          "when": "view == soas-cases && viewItem =~ /^case/",
          "group": "inline@1"
        },
        {
          "command": "soas.issues.open",
          "when": "view == soas-issues && viewItem =~ /^issue/",
          "group": "inline@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "soas.openDashboard",
        "key": "ctrl+shift+alt+d",
        "when": "soas.isAuthenticated"
      },
      {
        "command": "soas.incidents.create",
        "key": "ctrl+shift+alt+i",
        "when": "soas.isAuthenticated"
      },
      {
        "command": "soas.wiki.search",
        "key": "ctrl+shift+alt+w",
        "when": "soas.isAuthenticated"
      }
    ],
    "chatParticipants": [
      {
        "id": "soas.assistant",
        "fullName": "SOAS Assistant",
        "name": "soas",
        "description": "AI assistant for SOC operations, automation building, and wiki writing",
        "isSticky": true
      }
    ],
    "languageModelTools": [
      {
        "name": "soas_listIncidents",
        "displayName": "List SOAS Incidents",
        "modelDescription": "Lists incidents from the SOC on a Stick platform, optionally filtered by severity, status, or team.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
            "status": { "type": "string" },
            "page": { "type": "number", "default": 1 }
          }
        }
      },
      {
        "name": "soas_getIncident",
        "displayName": "Get SOAS Incident Details",
        "modelDescription": "Gets detailed information about a specific incident including timeline and notes.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "incidentId": { "type": "string" }
          },
          "required": ["incidentId"]
        }
      },
      {
        "name": "soas_listAutomations",
        "displayName": "List SOAS Automations",
        "modelDescription": "Lists automations from the SOC on a Stick platform.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["draft", "active", "disabled", "archived"] },
            "page": { "type": "number", "default": 1 }
          }
        }
      },
      {
        "name": "soas_getNodeCatalog",
        "displayName": "Get SOAS Node Catalog",
        "modelDescription": "Gets the full catalog of available node types for building visual automations. Each node has a type, inputs, outputs, and configurable properties.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "soas_getAutomationGraph",
        "displayName": "Get Automation Graph Data",
        "modelDescription": "Gets the graph data (nodes and connections) for a specific automation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "automationId": { "type": "string" }
          },
          "required": ["automationId"]
        }
      },
      {
        "name": "soas_searchWiki",
        "displayName": "Search SOAS Wiki",
        "modelDescription": "Searches wiki pages by query string.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" }
          },
          "required": ["query"]
        }
      },
      {
        "name": "soas_getWikiPage",
        "displayName": "Get SOAS Wiki Page",
        "modelDescription": "Gets the full content of a wiki page by slug.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": { "type": "string" }
          },
          "required": ["slug"]
        }
      },
      {
        "name": "soas_runAutomation",
        "displayName": "Run SOAS Automation",
        "modelDescription": "Executes an automation and returns the execution ID.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "automationId": { "type": "string" },
            "parameters": { "type": "object" }
          },
          "required": ["automationId"]
        }
      },
      {
        "name": "soas_createIncident",
        "displayName": "Create SOAS Incident",
        "modelDescription": "Creates a new incident in the SOC platform.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
            "summary": { "type": "string" }
          },
          "required": ["title", "severity"]
        }
      },
      {
        "name": "soas_getCurrentGraph",
        "displayName": "Get Current Graph State",
        "modelDescription": "Gets the current graph data (nodes, connections, positions) from the active graph editor panel. Returns VP2GraphData JSON with the automation name, description, and full graph structure.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "soas_updateAutomationGraph",
        "displayName": "Update Automation Graph",
        "modelDescription": "Pushes new VP2GraphData to the currently open graph editor, replacing the current graph. The graphData must be valid VP2GraphData JSON with 'nodes' (array of node objects with id, type, position, inputs, outputs) and 'connections' (array of connection objects linking node ports). Changes appear immediately in the editor as unsaved.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "graphData": {
              "type": "object",
              "description": "VP2GraphData JSON with nodes and connections arrays"
            }
          },
          "required": ["graphData"]
        }
      }
    ]
  }
}
